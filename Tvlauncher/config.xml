<?xml version="1.0" encoding="UTF-8"?>
<atv_launcher version="1.0">

    <!-- =========================================================
         ATV LAUNCHER CONFIG
         ไฟล์ตั้งค่าหลักสำหรับควบคุม Launcher จากระยะไกล

         การทำงานตอนเปิดแอป:
         1) Launcher โหลด XML ออนไลน์ก่อนเข้า Home
         2) ถ้าโหลดสำเร็จและ XML ถูกต้อง -> บันทึกเป็นไฟล์ล่าสุดใน Cache
         3) ถ้าไม่มีอินเทอร์เน็ต -> ใช้ XML ล่าสุดที่เคยบันทึกไว้
         4) ถ้าไม่มีทั้งอินเทอร์เน็ตและ Cache -> ใช้ค่า Default ภายใน APK

         สำคัญ:
         lock = 0 -> ทำงานเฉพาะ NORMAL
         lock = 1 -> ทำงานเฉพาะ LOCKED
         NORMAL และ LOCKED ต้องไม่สั่งงานข้ามกัน
    ========================================================== -->


    <!-- =========================================================
         1. MASTER MODE
         0 = โหมดปกติ
         1 = โหมดล็อก
    ========================================================== -->
    <lock>0</lock>


    <!-- =========================================================
         2. WALLPAPER
         ใช้รูปเดียวกันทั้งโหมดปกติและโหมดล็อก
    ========================================================== -->
    <wallpaper
        url="https://raw.githubusercontent.com/panda4477/App-ATV/refs/heads/main/Tvlauncher/1363137.png" />


    <!-- =========================================================
         3. NORMAL MODE
         ใช้งานเฉพาะเมื่อ <lock>0</lock>

         เมื่อ lock = 0:
         - เข้า Home ตามปกติ
         - ใช้ Wallpaper ด้านบน
         - ห้ามอ่าน/ทำคำสั่งใน <locked>
         - ห้าม Delete Apps
         - ห้ามแสดง Lock Popup
    ========================================================== -->
    <normal>

        <!-- 1 = เปิดหน้า Home ปกติ -->
        <home>1</home>

    </normal>


    <!-- =========================================================
         4. LOCK MODE
         ใช้งานเฉพาะเมื่อ <lock>1</lock>

         เมื่อ lock = 1:
         - ใช้ Wallpaper เดิม
         - แสดง Lock Popup
         - Remote Focus อยู่เฉพาะ Popup
         - เมนู Home ด้านหลังเลื่อนไม่ได้
         - BACK ห้ามปิด Lock Popup
         - อ่านคำสั่งเฉพาะในหมวดนี้
    ========================================================== -->
    <locked>


        <!-- =====================================================
             4.1 LOCK SCREEN
             ข้อความที่แสดงบน Popup ตอนล็อก
        ====================================================== -->
        <display>

            <!-- หัวข้อหลัก -->
            <title>DEVICE LOCKED</title>

            <!-- ข้อความรอง -->
            <message>อุปกรณ์เครื่องนี้ถูกล็อกการใช้งาน</message>

        </display>


        <!-- =====================================================
             4.2 CHECK STATUS
             ปุ่มนี้ให้ Launcher โหลด XML ออนไลน์ใหม่ทันที

             ตัวอย่าง:
             ถ้า Admin เปลี่ยน <lock>1</lock> เป็น <lock>0</lock>
             แล้วผู้ใช้กด CHECK STATUS
             Launcher จะโหลด XML ใหม่และปลด Lock
        ====================================================== -->
        <check_status>1</check_status>


        <!-- =====================================================
             4.3 SUPPORT
             กด SUPPORT แล้วเปิดรูป Support แบบเต็มจอ
             กด BACK เพื่อกลับมายังหน้า Lock
        ====================================================== -->
        <support
            enable="1"
            image="https://raw.githubusercontent.com/panda4477/App-ATV/refs/heads/main/Tvlauncher/support.png" />


        <!-- =====================================================
             4.4 DEVICE INFO
             1 = แสดงข้อมูลเครื่อง
             0 = ซ่อนข้อมูลเครื่อง

             ข้อมูลทั้งหมดให้ APK อ่านจากเครื่องโดยตรง
             ไม่ต้องกำหนดค่าจริงใน XML
        ====================================================== -->
        <device_info enable="1">

            <!-- ชื่ออุปกรณ์ -->
            <device_name>1</device_name>

            <!-- รุ่นเครื่อง -->
            <model>1</model>

            <!-- เวอร์ชัน Android -->
            <android_version>1</android_version>

            <!-- Build Number -->
            <build_number>1</build_number>

            <!-- IP Address -->
            <ip_address>1</ip_address>

        </device_info>


        <!-- =====================================================
             4.5 DELETE USER APPS

             0 = ไม่ลบแอป
             1 = ลบแอปที่ผู้ใช้ติดตั้งทั้งหมด

             เงื่อนไขสำคัญ:
             - ทำงานเฉพาะเมื่อ lock = 1
             - ถ้า lock = 0 ต้องไม่อ่านคำสั่งนี้
             - ไม่ลบ System Apps
             - ไม่ลบ ATV Launcher
             - ไม่ลบ Settings
             - ไม่ลบ Google/System Services
        ====================================================== -->
        <delete_apps>0</delete_apps>


    </locked>


</atv_launcher>
