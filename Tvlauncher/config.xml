<?xml version="1.0" encoding="UTF-8"?>

<atv_launcher version="1.0">

    <!-- =========================================================
         ATV LAUNCHER REMOTE CONFIG

         การทำงานตอนเปิด Launcher:
         1. โหลด XML จาก GitHub ก่อนเข้า Home
         2. ถ้าโหลดสำเร็จ ใช้ XML ตัวใหม่
         3. เก็บ XML ล่าสุดที่ใช้งานได้ไว้ใน Cache
         4. ถ้าไม่มีอินเทอร์เน็ต ใช้ XML เก่าจาก Cache
         5. ถ้าไม่มี Cache ใช้ค่า Default ภายใน APK

         lock = 0
         - ใช้งาน Launcher ปกติ
         - ทำงานเฉพาะ NORMAL
         - ห้ามทำคำสั่ง LOCK เด็ดขาด

         lock = 1
         - เข้าโหมด LOCK
         - ทำงานเฉพาะ LOCK
    ========================================================== -->


    <!-- =========================================================
         1. MASTER LOCK

         0 = NORMAL
         1 = LOCK
    ========================================================== -->

    <lock>0</lock>



    <!-- =========================================================
         2. NORMAL MODE
         ทำงานเฉพาะเมื่อ lock = 0
    ========================================================== -->

    <normal>


        <!-- Wallpaper หน้า Launcher ปกติ -->

        <wallpaper
            url="https://raw.githubusercontent.com/panda4477/App-ATV/refs/heads/main/Tvlauncher/1363137.png" />


        <!--
             1 = เปิดหน้า Home ปกติ
        -->

        <home>1</home>


    </normal>



    <!-- =========================================================
         3. LOCK MODE
         ทำงานเฉพาะเมื่อ lock = 1

         หน้า Home เดิมใช้งานไม่ได้
         รีโมตควบคุมเฉพาะเมนู Lock

         เมนูหน้า Lock:

         [ SUPPORT ]     [ DEVICE INFO ]

    ========================================================== -->

    <locked>


        <!-- =====================================================
             3.1 LOCK WALLPAPER

             Wallpaper สำหรับหน้า Lock
             สามารถเปลี่ยน URL ได้จาก XML
        ====================================================== -->

        <wallpaper
            url="https://raw.githubusercontent.com/panda4477/App-ATV/refs/heads/main/Tvlauncher/lock.png" />



        <!-- =====================================================
             3.2 LOCK DISPLAY
        ====================================================== -->

        <display>

            <title>DEVICE LOCKED</title>

        </display>



        <!-- =====================================================
             3.3 SUPPORT

             หน้า Lock มีเมนู SUPPORT

             เมื่อกด:
             - เปิดรูปตาม URL ด้านล่าง
             - แสดงข้อความใต้รูป
             - กด BACK กลับหน้า Lock

             สามารถเปลี่ยนทั้งรูปและข้อความจาก XML
        ====================================================== -->

        <support
            image="https://raw.githubusercontent.com/panda4477/App-ATV/refs/heads/main/Tvlauncher/support.png">

            <message>ติดต่อร้านนี้เพื่อปลดล็อกอีกครั้ง</message>

        </support>



        <!-- =====================================================
             3.4 DEVICE INFO

             0 = ซ่อน
             1 = แสดง

             ข้อมูลอ่านจากตัวกล่องจริง เช่น:

             Device Name
             Model
             Android Version
             Build Number
             IP Address
        ====================================================== -->

        <device_info>1</device_info>



        <!-- =====================================================
             3.5 DELETE USER APPS

             0 = ไม่ลบ
             1 = ลบแอปที่ผู้ใช้ติดตั้ง

             ทำงานเฉพาะเมื่อ lock = 1

             ถ้า lock = 0
             ห้ามทำคำสั่งนี้เด็ดขาด
             แม้ delete_apps จะเป็น 1 ก็ตาม

             ไม่ลบ:
             - System Apps
             - ATV Launcher
             - Settings
             - System UI
             - Google / Android System Services
        ====================================================== -->

        <delete_apps>0</delete_apps>


    </locked>



    <!-- =========================================================
         ตัวอย่าง

         NORMAL
         <lock>0</lock>

         LOCK
         <lock>1</lock>

         LOCK + ไม่ลบแอป
         <lock>1</lock>
         <delete_apps>0</delete_apps>

         LOCK + ลบ User Apps
         <lock>1</lock>
         <delete_apps>1</delete_apps>

    ========================================================== -->


</atv_launcher>
